PORT=8000
DB_URL=example.com
NODE_ENV=production

# JWT Secret Key
JWT_ACCESS_SECRET=secretKey_is_very_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=secretKey_is_very_secret&refresh
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=5m

# Bcrypt Salt
BCRYPT_SALT_ROUND=10

# google
GOOGLE_CLIENT_SECRET=G0OGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=G0OGLE_CLIENT_ID
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# express session
EXPRESS_SESSION_SECRET=express-session_secret

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Store Management
SMTP_FROM_EMAIL=noreply@example.com

# File Storage
UPLOAD_DIR=uploads
MAX_STORAGE_BYTES=16106127360

# Client URL (for OAuth redirects)
CLIENT_URL=http://localhost:3000